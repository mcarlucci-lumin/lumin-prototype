    "@a3-digital/lumin-ai-interface": "file:./vendor/a3-digital-lumin-ai-interface.tgz",
    "@a3-digital/ui-core": "file:./vendor/a3-digital-ui-core.tgz",
    "@a3-digital/ui-forms": "file:./vendor/a3-digital-ui-forms.tgz",
    "@a3-digital/ui-layouts": "file:./vendor/a3-digital-ui-layouts.tgz",
    "@a3-digital/ui-management": "file:./vendor/a3-digital-ui-management.tgz",
