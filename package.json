{
  "name": "lumin-prototype",
  "version": "0.1.0",
  "private": true,
  "stackblitz": {
    "installDependencies": false,
    "startCommand": "npm install --no-package-lock && npm start"
  },
  "scripts": {
    "start": "node scripts/start.js",
    "build": "ng build",
    "wire": "node scripts/wire-prototypes.js",
    "wire:watch": "node scripts/wire-prototypes.js --watch",
    "vendor:pack": "node scripts/pack-vendor.js",
    "vendor:refs": "node scripts/update-vendor-refs.js",
